# =========================
# Node / Vite / Frontend
# =========================
node_modules/
dist/
dist-ssr/
.vite/
*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Env
.env
.env.*
!.env.example

# =========================
# Tauri / Rust
# =========================
src-tauri/target/
src-tauri/gen/
src-tauri/.cargo/
src-tauri/Cargo.lock

# Tauri generated binaries / bundles
src-tauri/target/
src-tauri/bundle/
src-tauri/icons/*.icns
src-tauri/icons/*.ico

# Keep default icons if you want
# !src-tauri/icons/icon.png
# !src-tauri/icons/32x32.png
# !src-tauri/icons/128x128.png
# !src-tauri/icons/128x128@2x.png

# =========================
# Python
# =========================
__pycache__/
*.py[cod]
*$py.class

.venv/
venv/
env/
ENV/

.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Python build
build/
*.egg-info/
.eggs/
*.egg
pip-wheel-metadata/

# =========================
# Python plugins runtime data
# =========================
external-plugins/**/.venv/
external-plugins/**/venv/
external-plugins/**/__pycache__/
external-plugins/**/.pytest_cache/
external-plugins/**/logs/
external-plugins/**/downloads/
external-plugins/**/output/
external-plugins/**/temp/
external-plugins/**/tmp/
external-plugins/**/session.json

# Keep plugin fixtures if used for debugging
# external-plugins/**/fixtures/debug_input.json

